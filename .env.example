# Copy to .env for local development. NEVER commit a real .env (it is gitignored).
# Never paste real secrets into issues, logs or this file.

# --- Core ---
APP_ENV=development                 # "production" enforces https BASE_URL
LOG_LEVEL=info
PORT=8080
# Public URL of the dashboard. Passkeys are bound to this exact origin.
# Development may use http://localhost:8080; production must be https.
BASE_URL=http://localhost:8080

# --- Database (Neon) ---
# Use Neon's DIRECT connection string (host WITHOUT "-pooler"). Migrations and the job
# queue use session features that Neon's transaction pooler can break.
# Local Postgres example: postgres:///polinchaser?host=/tmp
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Dashboard sign-in (passkey only) ---
# 32+ random characters. Only used to register your FIRST passkey; unset it afterwards.
#   openssl rand -base64 36
ADMIN_SETUP_TOKEN=
# How many reverse proxies sit in front (Render = 1). Wrong values weaken rate limiting.
TRUSTED_PROXY_HOPS=1

# --- GitHub App (leave blank to run without GitHub) ---
GITHUB_APP_ID=
# PEM text with \n escapes, or the PEM base64-encoded
GITHUB_APP_PRIVATE_KEY=
# Random string you also paste into the GitHub App's webhook secret box
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE=https://api.github.com

# --- Email via Resend (leave blank to disable alerts) ---
RESEND_API_KEY=
EMAIL_FROM=PolinChaser <alerts@your-verified-domain.com>
RESEND_API_BASE=
# Signing secret of the Resend webhook (whsec_...). Enables bounce and complaint tracking at POST /webhooks/resend.
RESEND_WEBHOOK_SECRET=
NOTIFY_DEFAULT_RECIPIENTS=you@example.com
NOTIFY_MIN_SEVERITY=high            # critical | high | medium | low | info

# --- Worker tuning ---
WORKER_CONCURRENCY=2
JOB_LEASE=5m
# Rescan every repository at least this often (min 1h), or "off". Also rescans when detection rules change.
SCHEDULE_INTERVAL=24h
SCAN_TIMEOUT=10m

# --- Dependency advisories via OSV (OFF by default) ---
# When true, package names and versions from lockfiles are sent to osv.dev. No paths, code or repo names are sent.
OSV_ENABLED=false
OSV_API_BASE=

# --- Data retention (days, min 30, or "off" to keep forever) ---
RETENTION_SCAN_DAYS=180
RETENTION_AUDIT_DAYS=365

# --- Threat-intel feeds (none by default; see docs/THREAT-INTEL.md) ---
# Comma-separated https URLs of feeds YOU chose and have the right to use. No credentials in the URL.
INTEL_FEED_URLS=
# Re-fetch interval (min 15m) or "off"
INTEL_REFRESH_INTERVAL=6h

# --- Reserved ---
# SESSION_SECRET is read but not used today (sessions are random tokens stored hashed).
SESSION_SECRET=

# Run the worker inside the web process (single free Render service). Default off.
RUN_WORKER=false
